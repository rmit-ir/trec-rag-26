# Pyserini REST API access token (TREC RAG tracks)
# Request one by emailing get-pyserini@googlegroups.com
# Store the real value in .env or .env.local (both gitignored) — never commit it.
PYSERINI_API_TOKEN=

# --- Search services (src/utils/search*.py, src/tools/search_tool.py) ---------
# Single API key for the search services. Either a ready HTTP Basic token, or
# "user:pass" (auto base64-encoded). Currently used for dense retrieval auth.
SEARCH_API_KEY=user:pass
# Dense retrieval (Jina-v5 DiskANN) base URL.
DENSE_SEARCH_URL=https://index-climbmix-jina-v5-nano.dsync.net
# Sparse retrieval (BM25 index-server) base URL.
SPARSE_SEARCH_URL=http://127.0.0.1:8085
# Hosted Pyserini BM25 (Castorini/UWaterloo) full search URL; auth via
# PYSERINI_API_TOKEN above.
PYSERINI_SEARCH_URL=http://api.castorini.uwaterloo.ca/v1/climbmix-400b/search
