[6847465956a0f6376a605387:parallel_evidence]     "trajectory": "/scratch/fast/kun/projects/trec-rag-26/data/outputs/aus_agent_v2/20260807T020152984574+1000.write_a_comprehensive_analysis_for.trajectory.json"
[6847465956a0f6376a605387:parallel_evidence]   },
[6847465956a0f6376a605387:parallel_evidence]   "facets": [
[6847465956a0f6376a605387:parallel_evidence]     {
[6847465956a0f6376a605387:parallel_evidence]       "name": "Predictive policing",
[6847465956a0f6376a605387:parallel_evidence]       "brief": "Research responsible AI principles and practices in predictive policing, covering both place-based crime-hotspot forecasting and person-based recidivism risk assessment. Develop a graduate-level evaluation of mechanisms, documented outcomes, limitations, and safeguards, using peer-reviewed studies, credible industry or government reports, legal ethics guidance, and recognized ethical frameworks.",
[6847465956a0f6376a605387:parallel_evidence]       "must_cover": [
[6847465956a0f6376a605387:parallel_evidence]         "Bias arising from historical crime data, proxy variables, feedback loops, disparate impact, and systemic inequalities",
[6847465956a0f6376a605387:parallel_evidence]         "Transparency, explainability, auditability, due process, civil liberties, privacy, surveillance, and contestability concerns",
[6847465956a0f6376a605387:parallel_evidence]         "Effects on public trust, legitimacy, police-community relations, and accountability in law enforcement",
[6847465956a0f6376a605387:parallel_evidence]         "Social and economic benefits such as improved resource allocation, prevention, consistency, and potential cost savings",
[6847465956a0f6376a605387:parallel_evidence]         "Social and economic risks, including discriminatory enforcement, over-policing, false predictions, rights violations, and perpetuation of systemic bias",
[6847465956a0f6376a605387:parallel_evidence]         "Quantitative evidence and concrete examples where available, with citations for every substantive claim"
[6847465956a0f6376a605387:parallel_evidence]       ]
[6847465956a0f6376a605387:parallel_evidence]     },
[6847465956a0f6376a605387:parallel_evidence]     {
[6847465956a0f6376a605387:parallel_evidence]       "name": "AI contract analysis",
[6847465956a0f6376a605387:parallel_evidence]       "brief": "Research responsible use of AI tools for reviewing, extracting terms from, assessing, and drafting legal contracts. Evaluate ethical, social, and economic implications for legal professionals, clients, firms, and institutions, distinguishing assistive uses from inappropriate automation. Ground the analysis in peer-reviewed research, credible industry reports, professional legal ethics rules or guidance, and relevant AI ethical frameworks.",
[6847465956a0f6376a605387:parallel_evidence]       "must_cover": [
[6847465956a0f6376a605387:parallel_evidence]         "Data privacy, confidentiality, privilege, cybersecurity, data retention, vendor access, and risks from training or processing client documents",
[6847465956a0f6376a605387:parallel_evidence]         "Accuracy limitations, hallucinations, omitted clauses, contextual errors, automation bias, validation requirements, and appropriate human oversight",
[6847465956a0f6376a605387:parallel_evidence]         "Allocation of accountability and professional liability for errors among lawyers, firms, clients, developers, and vendors",
[6847465956a0f6376a605387:parallel_evidence]         "Efficiency, speed, consistency, accessibility, cost reduction, and potential expansion of access to legal services",
[6847465956a0f6376a605387:parallel_evidence]         "Job displacement, deskilling, changing junior-lawyer tasks, workforce restructuring, unequal access to tools, and creation of new oversight roles",
[6847465956a0f6376a605387:parallel_evidence]         "Quantitative evidence and concrete examples where available, with citations for every substantive claim"
[6847465956a0f6376a605387:parallel_evidence]       ]
[6847465956a0f6376a605387:parallel_evidence]     },
[6847465956a0f6376a605387:parallel_evidence]     {
[6847465956a0f6376a605387:parallel_evidence]       "name": "Cross-case synthesis",
[6847465956a0f6376a605387:parallel_evidence]       "brief": "Synthesize the predictive-policing and contract-analysis evidence into a comparative, graduate-seminar analysis of responsible AI in the legal field. Explain how differing stakes, affected populations, institutional settings, and error consequences shape governance requirements. Derive broader principles and practical strategies without treating the two applications as ethically equivalent, and anchor conclusions in cited peer-reviewed studies, industry reports, IEEE Ethically Aligned Design, the EU AI Act, and applicable legal ethics guidance.",
[6847465956a0f6376a605387:parallel_evidence]       "must_cover": [
[6847465956a0f6376a605387:parallel_evidence]         "Direct comparison of ethical, social, and economic implications across both cases, including benefits, risks, stakeholders, and distributions of gains and harms",
[6847465956a0f6376a605387:parallel_evidence]         "Broader principles of fairness, accountability, transparency, privacy, human agency, proportionality, reliability, contestability, and harm prevention",
[6847465956a0f6376a605387:parallel_evidence]         "Practical governance strategies such as impact assessments, bias testing, independent audits, documentation, explainability, procurement controls, monitoring, incident reporting, appeals, and meaningful human review",
[6847465956a0f6376a605387:parallel_evidence]         "How risk level, civil-liberties stakes, professional duties, and consequences of false positives, false negatives, or drafting errors should determine acceptable use or non-use",
[6847465956a0f6376a605387:parallel_evidence]         "Evaluation of alternatives and safeguards, including less intrusive or non-AI approaches, limitations of technical fixes, and conditions for deployment, suspension, or prohibition",
[6847465956a0f6376a605387:parallel_evidence]         "Critical comparison of relevant ethical frameworks and regulation, especially IEEE Ethically Aligned Design, the EU AI Act, and legal professional-responsibility guidelines",
[6847465956a0f6376a605387:parallel_evidence]         "A coherent conclusion suitable for a graduate-level technology-and-society seminar, with all substantive claims supported by qualifying citations"
[6847465956a0f6376a605387:parallel_evidence]       ]
[6847465956a0f6376a605387:parallel_evidence]     }
