[6847465956a0f6376a605493:parallel_evidence]     "trajectory": "/scratch/fast/kun/projects/trec-rag-26/data/outputs/aus_agent_v2/20260807T015416441499+1000.write_an_introduction_on_markov.trajectory.json"
[6847465956a0f6376a605493:parallel_evidence]   },
[6847465956a0f6376a605493:parallel_evidence]   "facets": [
[6847465956a0f6376a605493:parallel_evidence]     {
[6847465956a0f6376a605493:parallel_evidence]       "name": "Foundations and genesis",
[6847465956a0f6376a605493:parallel_evidence]       "brief": "Research material for an introductory section explaining Markov chains to a statistics/combinatorics audience, including their formal definition, core intuition, principal mathematical objects, and the historical problem that motivated their creation. Connect the statistical and combinatorial viewpoints without assuming advanced prior knowledge.",
[6847465956a0f6376a605493:parallel_evidence]       "must_cover": [
[6847465956a0f6376a605493:parallel_evidence]         "Markov property and dependence on the present state rather than the full history",
[6847465956a0f6376a605493:parallel_evidence]         "States, transition probabilities, transition matrices, paths, and multi-step transitions",
[6847465956a0f6376a605493:parallel_evidence]         "How Markov chains connect probability, statistics, and combinatorial counting",
[6847465956a0f6376a605493:parallel_evidence]         "Historical genesis, including Andrey Markov’s motivation and early dependent-trial or sequence applications",
[6847465956a0f6376a605493:parallel_evidence]         "Clarification of modeling assumptions and the distinction between discrete-time chains and related stochastic processes"
[6847465956a0f6376a605493:parallel_evidence]       ]
[6847465956a0f6376a605493:parallel_evidence]     },
[6847465956a0f6376a605493:parallel_evidence]     {
[6847465956a0f6376a605493:parallel_evidence]       "name": "Contemporary literature",
[6847465956a0f6376a605493:parallel_evidence]       "brief": "Develop an evidence-based literature review of how Markov chains feature in contemporary research. Organize the scholarship by major research themes and applications, identify influential methods and current directions, and discuss limitations or open challenges. Use representative recent and foundational sources needed to explain the modern work rather than producing an unstructured list of papers.",
[6847465956a0f6376a605493:parallel_evidence]       "must_cover": [
[6847465956a0f6376a605493:parallel_evidence]         "Representative contemporary research areas using Markov chains in statistics and combinatorics",
[6847465956a0f6376a605493:parallel_evidence]         "Markov chain Monte Carlo, including its role in statistical inference and computation",
[6847465956a0f6376a605493:parallel_evidence]         "Mixing times, coupling, spectral methods, and sampling or counting applications in combinatorics",
[6847465956a0f6376a605493:parallel_evidence]         "Selected applications in modern interdisciplinary research where the Markov structure is central",
[6847465956a0f6376a605493:parallel_evidence]         "Recent methodological developments, active research directions, and open problems",
[6847465956a0f6376a605493:parallel_evidence]         "Limitations such as state-space explosion, convergence diagnosis, dependence assumptions, and computational cost",
[6847465956a0f6376a605493:parallel_evidence]         "Accurate attribution and bibliographic evidence for major claims"
[6847465956a0f6376a605493:parallel_evidence]       ]
[6847465956a0f6376a605493:parallel_evidence]     },
[6847465956a0f6376a605493:parallel_evidence]     {
[6847465956a0f6376a605493:parallel_evidence]       "name": "Runs of heads application",
[6847465956a0f6376a605493:parallel_evidence]       "brief": "Create a self-contained section showing how Markov-chain intuition solves the problem of the expected number of fair-coin flips required to obtain N consecutive heads. Define an appropriate state space, derive and solve the expectation recurrence, give the general result, and use small cases to make the mechanism intuitive. Note assumptions and relevant variants without distracting from the requested example.",
[6847465956a0f6376a605493:parallel_evidence]       "must_cover": [
[6847465956a0f6376a605493:parallel_evidence]         "States representing the current run length from 0 through N, with N absorbing",
[6847465956a0f6376a605493:parallel_evidence]         "Transition behavior after a head and after a tail for a fair coin",
[6847465956a0f6376a605493:parallel_evidence]         "First-step recurrence for expected remaining flips and its solution",
[6847465956a0f6376a605493:parallel_evidence]         "General expected waiting-time formula for N consecutive heads",
[6847465956a0f6376a605493:parallel_evidence]         "Checks using small values of N and an intuitive explanation of why overlaps or resets matter",
[6847465956a0f6376a605493:parallel_evidence]         "Boundary conditions and assumptions, including independent fair flips",
[6847465956a0f6376a605493:parallel_evidence]         "Brief indication of how the setup or formula changes for a biased coin or other target patterns"
[6847465956a0f6376a605493:parallel_evidence]       ]
[6847465956a0f6376a605493:parallel_evidence]     }
[6847465956a0f6376a605493:parallel_evidence]   ],
