[6847465956a0f6376a605391:parallel_evidence]         "Regulatory requirements and hurdles in Singapore, Thailand, and Indonesia, including import, labeling, claims, food safety, and halal considerations",
[6847465956a0f6376a605391:parallel_evidence]         "Competitive whitespace and barriers to entry for a U.S.-based mid-stage company",
[6847465956a0f6376a605391:parallel_evidence]         "Evidence from public reports, company disclosures, regulatory sources, and industry benchmarks"
[6847465956a0f6376a605391:parallel_evidence]       ]
[6847465956a0f6376a605391:parallel_evidence]     },
