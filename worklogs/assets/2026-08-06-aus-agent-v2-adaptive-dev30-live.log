[6847465956a0f6376a605367:parallel_evidence]     },
[6847465956a0f6376a605367:parallel_evidence]     {
[6847465956a0f6376a605367:parallel_evidence]       "name": "Radiocarbon dating science and comparison",
[6847465956a0f6376a605367:parallel_evidence]       "brief": "Explain the scientific basis and practical workflow of carbon-14 dating for a general but informed audience, then compare it with at least two independent dating techniques. Ground claims about precision, age ranges, sample suitability, calibration, and uncertainty in scientific or archaeological sources; distinguish precision from accuracy and relative from absolute dating.",
[6847465956a0f6376a605367:parallel_evidence]       "must_cover": [
[6847465956a0f6376a605367:parallel_evidence]         "Explain carbon-14 production, incorporation into living organisms, radioactive decay after death, half-life, measurement of residual carbon-14, and conversion of measurements into age estimates.",
[6847465956a0f6376a605367:parallel_evidence]         "Describe sampling, pretreatment, contamination control, conventional decay counting versus accelerator mass spectrometry where relevant, and calibration against reference curves.",
[6847465956a0f6376a605367:parallel_evidence]         "Specify which organic or carbon-bearing materials can and cannot generally be dated, including complications such as reservoir effects, reuse, and the relationship between a sample’s age and the archaeological event of interest.",
[6847465956a0f6376a605367:parallel_evidence]         "Explain limitations, including usable age range, sample destruction or size, contamination, calibration-curve plateaus, old-wood effects, contextual uncertainty, and statistical reporting of date ranges.",
[6847465956a0f6376a605367:parallel_evidence]         "Compare carbon dating with at least two other techniques—such as dendrochronology, thermoluminescence/optically stimulated luminescence, uranium-series, archaeomagnetism, or stratigraphy—in terms of precision, applicability, datable materials, effective time range, limitations, and typical use cases."
[6847465956a0f6376a605367:parallel_evidence]       ]
[6847465956a0f6376a605367:parallel_evidence]     },
[6847465956a0f6376a605367:parallel_evidence]     {
[6847465956a0f6376a605367:parallel_evidence]       "name": "Archaeological impact and case studies",
[6847465956a0f6376a605367:parallel_evidence]       "brief": "Assess the real-world usefulness and historical impact of radiocarbon dating through at least two well-documented archaeological or historical case studies in which it materially revised or confirmed a timeline. Select cases supported by primary studies or strong scholarly syntheses, explain the dating evidence and context, and connect technical results to broader historical interpretation without overstating certainty.",
[6847465956a0f6376a605367:parallel_evidence]       "must_cover": [
[6847465956a0f6376a605367:parallel_evidence]         "Discuss how radiocarbon dating is used to build, test, revise, or confirm archaeological and historical chronologies, including its value when written records are absent, disputed, or imprecise.",
[6847465956a0f6376a605367:parallel_evidence]         "Analyze at least two distinct, well-documented case studies where radiocarbon dating was pivotal rather than incidental.",
[6847465956a0f6376a605367:parallel_evidence]         "For each case, state the prior chronology or controversy, materials sampled, dating approach and calibrated results or ranges, relevant uncertainties, and how the findings revised or confirmed the timeline.",
[6847465956a0f6376a605367:parallel_evidence]         "Explain the implications of each discovery for understanding history, such as migration, settlement, political chronology, technological change, cultural interaction, or the reliability of textual traditions.",
[6847465956a0f6376a605367:parallel_evidence]         "Evaluate limits on interpretation in the selected cases, including sampling context, calibration, contamination, competing evidence, and whether later research supports or challenges the radiocarbon-based conclusion.",
[6847465956a0f6376a605367:parallel_evidence]         "Synthesize the broader impact of radiocarbon dating on archaeology and history using quantitative evidence and appropriately cited scholarly sources where available."
[6847465956a0f6376a605367:parallel_evidence]       ]
[6847465956a0f6376a605367:parallel_evidence]     }
