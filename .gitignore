*~

# Virtual environments (uv default is .venv)
.venv/
venv/
env/

# Node (pnpm tasks, e.g. tasks/loadtest)
node_modules/

# Downloaded Java tooling (e.g. Anserini fat jar) — not source, re-downloadable
*.jar
tasks/bm25_index/jars/

# Logs, data, and run outputs
*.log
# Access logs (per-run search query logs) — whole folder
tasks/search_serve/logs/
data/*
# Official datasets tracked as submodules
!data/official/
# Run artifacts + human feedback are deliberately tracked
!data/outputs/
!data/output_feedbacks/
runs/
results/
output/
tmp/
# ...but these are bare patterns, so they match a directory of those names at
# ANY depth — including source. The viewer's Next.js route lives at
# src/app/api/runs/, which `runs/` silently swallowed: `git add` refused it, so
# the feature would have worked locally and 404'd on deploy with nothing in
# `git status` to explain it. Re-include the source tree (the parent dirs are
# not themselves ignored, so this negation takes effect).
!tasks/outputs_viewer/src/app/api/runs/

# Git worktrees
/worktrees/

# Corpus-creation skill baselines
baselines/rag25_climbmix/cache/
baselines/rag25_climbmix/runs/smoke/

# Note: uv.lock is intentionally tracked — commit it for reproducible installs.
