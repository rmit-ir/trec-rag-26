# Secrets and local config
.env
.env.local
.env.*.local
.curlrc.pyserini-rest

# OS files
.DS_Store
Thumbs.db

# Python development artifacts
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg
*.egg-info/
dist/
build/

# Test and type-checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/

# IDE and editor files
.vscode/
.claude/
.agents/
.codex/
.idea/
*.swp
*.swo
*~

# Virtual environments (uv default is .venv)
.venv/
venv/
env/

# Node (pnpm tasks, e.g. tasks/loadtest)
node_modules/

# Downloaded Java tooling (e.g. Anserini fat jar) — not source, re-downloadable
*.jar
tasks/bm25_index/jars/

# Logs, data, and run outputs
*.log
# ...except worklog assets: CLAUDE.md requires a raw sweep/judge log copied in
# there to be committed, since it is the only surviving evidence behind an
# experiment worklog's judgment calls. Was needing `git add -f` every time.
!worklogs/assets/*.log
*.bak
# Per-run log folders (may hold non-.log artifacts too)
tasks/search_serve/logs/
tasks/task-comparison/logs/
data/*
# Official datasets tracked as submodules (except re-downloadable bulk pulls)
!data/official/
data/official/browsecomp-plus/
# Outputs are large — synced between servers via rsync, not git.
# (Human feedback is small and curated, so it stays tracked.)
!data/output_feedbacks/
# Backend-comparison: code lives in tasks/task-comparison/; result docs + small
# summaries under data/task-comparison/ ARE tracked, but large regenerable
# intermediates (judgment caches, pools, embeddings, doc-text, id maps) are not.
!data/task-comparison/
data/task-comparison/rubric-judge/out/*judgments/
data/task-comparison/rubric-judge/out/pool.json
data/task-comparison/rubric-judge/out/provenance.json
data/task-comparison/rubric-judge/out/retrieved_raw.json
data/task-comparison/diversity/*.npy
data/task-comparison/diversity/*.jsonl
data/task-comparison/test119-eval/
tmp/

# Git worktrees
/worktrees/

# Corpus-creation skill baselines
baselines/rag25_climbmix/cache/
baselines/rag25_climbmix/runs/smoke/

# Note: uv.lock is intentionally tracked — commit it for reproducible installs.
